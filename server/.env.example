# Copy to server/.env for local development. Every value is optional:
# with nothing set, Tideover runs fully offline (PayPal simulator + rule-based AI).

# --- PayPal (developer.paypal.com → Apps & Credentials → Sandbox) ---------
# Setting both switches PAYPAL_MODE to sandbox automatically.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the same app's Webhooks section (needed to verify signatures).
PAYPAL_WEBHOOK_ID=
# sandbox | simulated (live is supported but never needed for the hackathon)
# PAYPAL_MODE=sandbox
# Sandbox *personal* account email used by `npm run verify:paypal` for a $1 payout.
PAYPAL_TEST_RECEIVER=

# --- Claude (console.anthropic.com) ----------------------------------------
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- AG Grid (staff Ledger) -------------------------------------------------
# AG Grid Enterprise licence. Without it the Ledger runs in evaluation mode with a watermark.
# AG_GRID_LICENSE_KEY=

# --- Server ----------------------------------------------------------------
# Public URL PayPal redirects back to (checkout return, Log in with PayPal callback).
# PUBLIC_URL=http://localhost:8080
# PORT=8080
# Postgres in production; leave unset to use the embedded database in DATA_DIR.
# DATABASE_URL=postgres://user:pass@localhost:5432/tideover
# Serve the Flutter web build from the API (after `flutter build web`).
WEB_DIR=../app/build/web
# Required in production.
# JWT_SECRET=change-me-to-a-long-random-string
# Staff logins. While both are the defaults, the console offers one-click demo sign-in.
# ADMIN_PASSWORD=tideover-admin
# REVIEWER_PASSWORD=tideover-review
